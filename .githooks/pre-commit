#!/bin/sh
set -eu

# The workspace keeps one canonical Cargo.lock that resolves the tagged Optics
# Git sources. Local development points the build scripts at a sibling Optics
# checkout through `.cargo/config.toml` `[env]` entries, never through a Cargo
# `[patch]`; the lockfile is therefore committable from every worktree.
#
# Refuse a manifest/lockfile commit that would not resolve with `--locked`.
changed=$(git diff --cached --name-only --diff-filter=ACMR)

if printf '%s\n' "$changed" | grep -Eq '(^|/)(Cargo\.toml|Cargo\.lock)$'; then
    printf '%s\n' "Validating canonical Cargo.lock."
    cargo metadata --locked --format-version 1 >/dev/null
fi

# `.cargo/config.toml` is a machine-local override and is gitignored; guard
# against a forced add anyway.
if printf '%s\n' "$changed" | grep -q '^\.cargo/config\.toml$'; then
    printf '%s\n' \
        "Refusing to commit .cargo/config.toml." \
        "It is a machine-local Optics checkout pointer; keep it untracked." >&2
    exit 1
fi
